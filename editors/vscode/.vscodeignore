# Sources, tests, and build leftovers stay out of the package. The compiled
# extension in out/ and the grammar in syntaxes/ are what the editor loads.
src/**
test/**
out/test/**
out/**/*.map
tsconfig.json
*.vsix
node_modules/.bin
node_modules/@vscode
node_modules/@types
node_modules/typescript
node_modules/vscode-textmate
node_modules/vscode-oniguruma
node_modules/.package-lock.json

